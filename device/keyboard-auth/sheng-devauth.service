[Unit]
Description=Xiaomi sheng keyboard authentication
Requires=dev-tee0.device dev-nanosic_auth.device
After=systemd-udevd.service dev-tee0.device dev-nanosic_auth.device
ConditionPathExists=/dev/tee0
ConditionPathExists=/dev/nanosic_auth
ConditionPathExists=/usr/lib/firmware/qcom/sm8550/sheng/devauth.mbn
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/libexec/sheng-devauth
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
