+# Sheng hardening: never carry an authentication verdict across an observed
+# USB-C detach/replacement. This check cannot make separate firmware writes atomic.
+_session_started = False
+_session_attach = None
+
+def check_connection():
+    if not _session_started:
+        return
+    if not usb_is_online() or current_attach_token() != _session_attach:
+        raise ConnectionError("USB attachment changed; authentication cancelled")
+
+def begin_session():
+    global _session_started, _session_attach
+    _session_attach = current_attach_token()
+    _session_started = True
+    check_connection()
+
+def stop_requested(signum, frame):
+    raise InterruptedError("Authentication interrupted")
