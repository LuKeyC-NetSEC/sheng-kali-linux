+bool VirtualKeyboardDBus::restartInputMethod(const QString &expectedDesktopFile)
+{
+    if (expectedDesktopFile.isEmpty() || expectedDesktopFile != configuredInputMethod()) {
+        return false;
+    }
+    // Recreate the socket/process in memory. Never persist an empty InputMethod
+    // merely to force a reload: interruption must not disable the next login.
+    return m_inputMethod->restartInputMethod();
